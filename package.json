{
  "name": "nail-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3335",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3335}",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*",
    "db:inspect": "node scripts/database.mjs inspect",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:provision": "node scripts/database.mjs provision",
    "db:verify": "node scripts/database.mjs verify"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
