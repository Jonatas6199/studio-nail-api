# Chaves públicas do projeto. Nunca use service_role aqui.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
APP_URL=http://127.0.0.1:3335
# Usado apenas pelo script administrativo de preparação do banco.
SUPABASE_OWNER_EMAIL=seu-email@exemplo.com
DIRECT_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
# Notificações: gerar com scripts/configure-push.mjs. Nunca usar a conexão administrativa no worker.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_DATABASE_URL=
PUSH_WORKER_ENABLED=false
